[DYUD200]
; 使用する DY-UD200 のインデックス（0 始まり。複数台接続時に指定）
DeviceIndex=0

; 本体内蔵 B-CAS スロットで ARIB STD-B25 復号を行う（1=有効 / 0=無効、既定 1）
; カード未挿入時は自動的に無効となり生 TS を出力します
EnableB25=1

; パッチ済みファームウェアで TS XOR 復号を無効化する場合は 1
NoXor=0

; 選局直後の安定化フィルター（Settler）を無効化する場合は 1
NoSettle=0

; ワンセグモードで受信する場合は 1
OneSeg=0

; 選局後のロック待機タイムアウト（ミリ秒）
LockTimeoutMs=3000
